diff --git a/Makefile b/Makefile
index f5e3bf2..58aa391 100644
--- a/Makefile
+++ b/Makefile
@@ -536,6 +536,26 @@ else ifeq ($(platform), miyoomini)
 	ARCH = arm
 	BUILTIN_GPU = neon
 
+# NxRedux desktop (macOS/Linux host build)
+else ifeq ($(platform), desktop)
+	TARGET := $(TARGET_NAME)_libretro.so
+	CC = $(CROSS_COMPILE)gcc
+	CXX = $(CROSS_COMPILE)g++
+	AR = $(CROSS_COMPILE)ar
+	fpic := -fPIC
+	CFLAGS += -fomit-frame-pointer -ffast-math
+	# ARM64 dynarec (arm/arm64_stub.S) emits mid-line asm labels the Mach-O
+	# assembler rejects, and calls into C without the leading "_" Mach-O
+	# symbol names require; ship the portable C interpreter (cpu.cc) instead.
+	HAVE_DYNAREC = 0
+	ifeq ($(shell uname -s), Darwin)
+		# macOS ld rejects GNU --version-script; plain -shared yields a
+		# dlopen-able Mach-O .so.
+		SHARED := -shared
+	else
+		SHARED := -shared -Wl,--version-script=link.T -Wl,-no-undefined
+	endif
+
 # Windows
 else
 	TARGET := $(TARGET_NAME)_libretro.dll
