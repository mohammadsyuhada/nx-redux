diff --git forkSrcPrefix/Makefile.libretro forkDstPrefix/Makefile.libretro
index 24e5dce..81de9fa 100644
--- forkSrcPrefix/Makefile.libretro
+++ forkDstPrefix/Makefile.libretro
@@ -421,6 +421,33 @@ else ifeq ($(platform), miyoo)
    CFLAGS += -fno-common -ftree-vectorize -funswitch-loops
    DEFINES += -std=c99
 
+# NxRedux debug
+else ifeq ($(platform), desktop)
+   TARGET := $(TARGET_NAME)_libretro.so
+   CC = $(CROSS_COMPILE)gcc
+   CXX = $(CROSS_COMPILE)g++
+   AR = $(CROSS_COMPILE)ar
+   # macOS ld does not support GNU --version-script
+   SHARED := -shared -W
+   fpic := -fPIC
+   # macOS libc already provides these natively; mgba's own declarations
+   # (missing restrict-qualified matches to macOS's fortified prototypes)
+   # would otherwise conflict.
+   PLATFORM_DEFINES += -D_GNU_SOURCE -DHAVE_STRTOF_L -DHAVE_LOCALE -DHAVE_STRLCPY -DHAVE_STRDUP -DHAVE_STRNDUP
+   # macOS declares strtof_l()/locale_t in xlocale.h, not pulled in by
+   # <stdlib.h> the way glibc does; force it in everywhere.
+   CFLAGS += -include xlocale.h
+   CFLAGS += -fomit-frame-pointer -ffast-math
+   CFLAGS += -march=native
+   CFLAGS += -fno-common -ftree-vectorize -funswitch-loops
+   HAVE_NEON = 1
+   ARCH = arm64
+   BUILTIN_GPU = neon
+   CPU_ARCH := arm
+   MMAP_JIT_CACHE = 1
+   HAVE_DYNAREC = 1
+   DEFINES += -std=c99
+
 # Windows
 else
    TARGET := $(TARGET_NAME)_libretro.dll
