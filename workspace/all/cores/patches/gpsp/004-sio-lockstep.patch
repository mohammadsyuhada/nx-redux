--- /dev/null
+++ forkDstPrefix/nx_sio_lockstep.c
@@ -0,0 +1,4 @@
+/* NXRedux: compiles the lockstep link state machine into the core. The
+ * source lives (and is unit-tested) in the NXRedux tree at
+ * workspace/all/cores/gpsp/; Makefile.common puts that on the include path. */
+#include "sio_lockstep.c"
diff --git forkSrcPrefix/serial.c forkDstPrefix/serial.c
index 55bf2e1..a722f89 100644
--- forkSrcPrefix/serial.c
+++ forkDstPrefix/serial.c
@@ -18,6 +18,7 @@
  */
 
 #include "common.h"
+#include "sio_lockstep.h"
 
 int serial_mode = SERIAL_MODE_AUTO;
 
@@ -73,6 +74,166 @@ uint16_t serial_mul_siocnt() {
   return ret;
 }
 
+/* ---- NXRedux: lockstep link cable (gpsp_serial "lockstep") ----------------
+ * Two gpSP instances act as one cable: the side that starts a transfer sends
+ * its word, emulates the transfer's normal duration, then waits here (in the
+ * CPU loop, not the frontend) for the peer's word; netplay client 0 paces
+ * client 1's timeline. Protocol/state machine: sio_lockstep.c (NXRedux tree,
+ * host unit-tested; compiled in by nx_sio_lockstep.c). */
+void netpacket_send(uint16_t client_id, const void *buf, size_t len);
+void netpacket_poll_receive();
+
+static const u16 lockstep_multi_tim[] = {
+  CLOCK_CYC_9600_16BIT, CLOCK_CYC_38400_16BIT,
+  CLOCK_CYC_57600_16BIT, CLOCK_CYC_115200_16BIT };
+
+static SioLs lockstep;
+static bool lockstep_ready;
+static u8 lockstep_mode;        // SIOLS_* of the transfer we started
+static u32 lockstep_own;        // our word in it
+static int lockstep_stats = -1; // NX_SIO_STATS=1: a stats line per 60 frames
+static unsigned lockstep_frames;
+
+static uint64_t ls_now_us(void *c) {
+  struct timespec t;
+  (void)c;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return (uint64_t)t.tv_sec * 1000000u + (uint64_t)t.tv_nsec / 1000u;
+}
+static void ls_sleep_us(void *c, unsigned us) {
+  struct timespec t = { 0, (long)us * 1000L };
+  (void)c;
+  nanosleep(&t, NULL);
+}
+static void ls_send(void *c, const void *b, size_t n) {
+  (void)c;
+  netpacket_send(RETRO_NETPACKET_BROADCAST, b, n);
+}
+static void ls_poll(void *c) {
+  (void)c;
+  netpacket_poll_receive();
+}
+
+static SioLs *ls(void) {
+  if (!lockstep_ready) {
+    SioLsIo io = { NULL, ls_send, ls_poll, ls_now_us, ls_sleep_us };
+    siols_init(&lockstep, &io);
+    lockstep_ready = true;
+  }
+  return &lockstep;
+}
+
+void lockstep_net_start(bool leader) { siols_start(ls(), leader); }
+void lockstep_net_stop(void) { siols_stop(ls()); }
+void lockstep_net_receive(const void *buf, size_t len) { siols_on_packet(ls(), buf, len); }
+
+static u32 lockstep_normal_cycles(u8 ctrl, bool is32) {
+  u32 c = (ctrl & 0x2) ? CLOCK_CYC_2MHZ_8BIT : CLOCK_CYC_256KHZ_8BIT;
+  return is32 ? c << 2 : c;
+}
+
+// write_siocnt: we start a transfer (MULTI parent, or NORMAL internal clock).
+static void lockstep_initiate(u8 mode, u16 siocnt) {
+  lockstep_mode = mode;
+  if (mode == SIOLS_MULTI)
+    lockstep_own = read_ioreg(REG_SIOMLT_SEND);
+  else if (mode == SIOLS_NORMAL32)
+    lockstep_own = read_ioreg32(REG_SIODATA32_L);
+  else
+    lockstep_own = read_ioreg(REG_SIOMLT_SEND) & 0xFF; // SIODATA8 is 0x400012A too
+  siols_initiate(ls(), mode, siocnt & 0x3, lockstep_own);
+}
+
+// The transfer we started completes now: wait for the peer's word.
+static void lockstep_finish(void) {
+  u32 peer = siols_complete(ls());
+  if (lockstep_mode == SIOLS_MULTI) {
+    write_ioreg(REG_SIOMULTI0, lockstep_own);
+    write_ioreg(REG_SIOMULTI1, peer);
+    write_ioreg(REG_SIOMULTI2, 0xFFFF);
+    write_ioreg(REG_SIOMULTI3, 0xFFFF);
+  } else if (lockstep_mode == SIOLS_NORMAL32) {
+    write_ioreg(REG_SIODATA32_L, peer & 0xFFFF);
+    write_ioreg(REG_SIODATA32_H, peer >> 16);
+  } else
+    write_ioreg(REG_SIOMLT_SEND, peer & 0xFF);
+}
+
+// The peer started a transfer: answer with our word, run our half of it.
+static void lockstep_respond(const SioLsMsg *st) {
+  u16 cnt = read_ioreg(REG_SIOCNT);
+  u32 hw = get_serial_mode(cnt, read_ioreg(REG_RCNT));
+  if (st->mode == SIOLS_MULTI) {
+    if (hw != SERIAL_MODE_MULTI) { // not on the cable yet: the parent reads "no partner"
+      siols_reply(ls(), st, 0xFFFF);
+      return;
+    }
+    u16 mine = read_ioreg(REG_SIOMLT_SEND);
+    siols_reply(ls(), st, mine);
+    write_ioreg(REG_SIOMULTI0, st->word);
+    write_ioreg(REG_SIOMULTI1, mine);
+    write_ioreg(REG_SIOMULTI2, 0xFFFF);
+    write_ioreg(REG_SIOMULTI3, 0xFFFF);
+    write_ioreg(REG_SIOCNT, cnt | 0x80); // busy until the completion IRQ clears it
+    serial_irq_cycles = lockstep_multi_tim[st->ctrl & 0x3] * 2;
+  } else {
+    bool is32 = st->mode == SIOLS_NORMAL32;
+    // A NORMAL slave takes part only when armed: start bit set, external clock.
+    if (hw != SERIAL_MODE_NORMAL || !(cnt & 0x80) || (cnt & 0x1)) {
+      siols_reply(ls(), st, is32 ? 0xFFFFFFFFu : 0xFFu);
+      return;
+    }
+    u32 mine = is32 ? read_ioreg32(REG_SIODATA32_L) : (read_ioreg(REG_SIOMLT_SEND) & 0xFF);
+    siols_reply(ls(), st, mine);
+    if (is32) {
+      write_ioreg(REG_SIODATA32_L, st->word & 0xFFFF);
+      write_ioreg(REG_SIODATA32_H, st->word >> 16);
+    } else
+      write_ioreg(REG_SIOMLT_SEND, st->word & 0xFF);
+    serial_irq_cycles = lockstep_normal_cycles(st->ctrl, is32);
+  }
+}
+
+// update_serial, before the IRQ countdown: advance our timeline; a transfer
+// we started that ends within these cycles needs the peer's word now.
+static void lockstep_update_begin(unsigned cycles) {
+  SioLs *s = ls();
+  siols_advance(s, cycles);
+  if (s->xfer_active && serial_irq_cycles && serial_irq_cycles <= cycles)
+    lockstep_finish();
+}
+
+// update_serial, after the countdown: poll, keep client 1 within reach of
+// client 0's timeline, answer STARTs that are due.
+static void lockstep_update_end(void) {
+  SioLs *s = ls();
+  SioLsMsg st;
+  siols_service(s, serial_irq_cycles != 0);
+  while (siols_take_start(s, serial_irq_cycles != 0, &st))
+    lockstep_respond(&st);
+}
+
+void lockstep_frame_update(void) {
+  if (lockstep_stats < 0) {
+    const char *v = getenv("NX_SIO_STATS");
+    lockstep_stats = v && v[0] == '1';
+  }
+  if (!lockstep_stats || ++lockstep_frames < 60)
+    return;
+  lockstep_frames = 0;
+  SioLsStats *t = &ls()->st;
+  if (t->xfers || t->replies || t->timeouts || t->bound_waits)
+    fprintf(stderr, "sio-lockstep: %s xfers=%u replies=%u wait_avg_us=%llu wait_max_us=%llu "
+            "wait_ms(<.5/<1/<2/<5/>=5)=%u/%u/%u/%u/%u timeouts=%u resends=%u reanswers=%u "
+            "bound_waits=%u bound_timeouts=%u\n",
+            ls()->leader ? "leader" : "follower", t->xfers, t->replies,
+            (unsigned long long)(t->xfers ? t->wait_us_total / t->xfers : 0),
+            (unsigned long long)t->wait_us_max, t->hist[0], t->hist[1], t->hist[2],
+            t->hist[3], t->hist[4], t->timeouts, t->resends, t->reanswers,
+            t->bound_waits, t->bound_timeouts);
+  memset(t, 0, sizeof(*t));
+}
+
 cpu_alert_type write_rcnt(u16 value) {
   u16 oldval = read_ioreg(REG_RCNT);
   u32 pvmode = get_serial_mode(oldval, read_ioreg(REG_RCNT));
@@ -158,6 +319,13 @@ cpu_alert_type write_siocnt(u16 value) {
         serial_irq_cycles = CLOCK_CYC_64KHZ_32BIT;
       }
     }
+    else if (serial_mode == SERIAL_MODE_LOCKSTEP) {
+      // We drive the clock: start a transfer with the other gpSP.
+      if ((newval & 0x0080) && (newval & 0x1) && !serial_irq_cycles) {
+        serial_irq_cycles = lockstep_normal_cycles(newval & 0x3, newval & 0x1000);
+        lockstep_initiate((newval & 0x1000) ? SIOLS_NORMAL32 : SIOLS_NORMAL8, newval);
+      }
+    }
     break;
 
   case SERIAL_MODE_MULTI:
@@ -178,6 +346,8 @@ cpu_alert_type write_siocnt(u16 value) {
         serialpoke_master_send();
       else if (serial_mode == SERIAL_MODE_SERIAL_AW1 || serial_mode == SERIAL_MODE_SERIAL_AW2)
         serialaw_master_send();
+      else if (serial_mode == SERIAL_MODE_LOCKSTEP)
+        lockstep_initiate(SIOLS_MULTI, newval);
     }
 
     break;
@@ -191,30 +361,17 @@ cpu_alert_type write_siocnt(u16 value) {
 
 // How many cycles until the next serial event happens. Return MAX otherwise.
