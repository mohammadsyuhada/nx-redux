+// GCC 8.3.0 ICE workaround (tg5040 toolchain; internal compiler error in
+// gen_reg_rtx at emit-rtl.c:1187 while expanding this file's global
+// initializer; absent under GCC 10.3.0). Root cause: InterruptSourceList
+// below is `static const`, but its entries used to store a `const u16*`
+// initialized via &INTC_IPRA.reg_data (SH4IO_REG_T reinterpret-casts the
+// INTC[5] MMIO array) — a reinterpret_cast is never a core constant
+// expression, so the whole array needed a dynamic global constructor to
+// compute ~22 pointers at process startup, and GCC 8.3.0's aarch64 backend
+// crashes expanding that constructor. Replacing the pointer field with this
+// enum tag (resolved to the live register in GetPrLvl() below, at the same
+// call site and cost as the old `*PrioReg` dereference) makes
+// InterruptSourceList fully constant-initializable again — no dynamic
+// initializer is emitted, and the ICE construct no longer exists. Purely a
+// storage-representation change; behavior is identical.
+enum class IprReg : u8 { Fixed, IPRA, IPRB, IPRC };
 
 struct InterptSourceList_Entry
 {
-	const u16* PrioReg;
+	IprReg Reg;
 	u32 Shift;
 	Sh4ExceptionCode IntEvnCode;
 
-	int GetPrLvl() const { return (*PrioReg >> Shift) & 0xF; }
+	int GetPrLvl() const
+	{
+		u16 v;
+		switch (Reg)
+		{
+		case IprReg::IPRA: v = INTC_IPRA.reg_data; break;
+		case IprReg::IPRB: v = INTC_IPRB.reg_data; break;
+		case IprReg::IPRC: v = INTC_IPRC.reg_data; break;
+		default:           v = IRLPriority;        break;
+		}
+		return (v >> Shift) & 0xF;
+	}
 };
 
