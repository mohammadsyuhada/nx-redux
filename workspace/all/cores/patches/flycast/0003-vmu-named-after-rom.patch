+// NX Redux: a game's discs share one card, so drop a "(Disc N)" / "(Disc N of M)"
+// tag from the content name (minarch passes the disc file, not the .m3u)
+static std::string vmuContentName()
+{
+	std::string name(content_name);
+	size_t tag = name.find(" (Disc ");
+	if (tag != std::string::npos)
+	{
+		size_t end = name.find(')', tag);
+		if (end != std::string::npos)
+			name.erase(tag, end - tag + 1);
+	}
+	return name;
+}
