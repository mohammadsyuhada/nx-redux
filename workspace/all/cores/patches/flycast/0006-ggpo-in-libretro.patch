+#ifdef NX_LIBRETRO_GGPO
+// NX Redux: GGPO rollback netplay in the libretro core. The frontend's launcher
+// runs the session setup (peer discovery, save sync) and hands the result over
+// in environment variables, read here before the game loads; the handshake the
+// standalone UI runs (core/ui/gui.cpp) is started and awaited after the load.
+//   NX_GGPO=1                  start a session
+//   NX_GGPO_HOST=1|0           host (player 1) or client (player 2)
+//   NX_GGPO_SERVER=<ip>        the peer's address (both sides need it)
+//   NX_GGPO_HLE=1              use the HLE BIOS (the two sides' BIOS differ)
+//   NX_GGPO_DISCONNECT_MS=<n>  peer silence before the session ends (ggpo.cpp)
+//   NX_GGPO_TIMEOUT=<s>        how long to wait for the peer at start
+// The input delay is a core option (reicast_netplay_delay), set per player.
+#include "network/net_handshake.h"
+#include "network/ggpo.h"
+#include <chrono>
+static bool nx_ggpo_env_is(const char *name, const char *value)
+{
+	const char *v = getenv(name);
+	return v != nullptr && strcmp(v, value) == 0;
+}
+static bool nx_ggpo_configure()
+{
+	ggpo::nxStopRequested = false;
+	if (!nx_ggpo_env_is("NX_GGPO", "1"))
+		return false;
+	const char *server = getenv("NX_GGPO_SERVER");
+	config::GGPOEnable.override(true);
+	config::NetworkEnable.override(false);
+	config::ActAsServer.override(nx_ggpo_env_is("NX_GGPO_HOST", "1"));
+	config::NetworkServer.override(std::string(server != nullptr ? server : ""));
+	if (nx_ggpo_env_is("NX_GGPO_HLE", "1"))
+		config::UseReios.override(true);
+	// Everything that changes what the emulated machine does must be the same
+	// on both sides, or the session desyncs. Region, language and broadcast
+	// follow the disc and the (host-synced) console flash; render-only options
+	// (resolution, widescreen hack, frame skip, sorting) stay per device.
+	config::Region.override(3);		// Default
+	config::Language.override(6);	// Default
+	config::Broadcast.override(4);	// Default
+	config::Sh4Clock.override(200);
+	config::DSPEnabled.override(false);
+	config::WidescreenGameHacks.override(false);
+	config::FastGDRomLoad.override(false);
+	config::RamMod32MB.override(false);
+	config::ForceFreePlay.override(true);
+	config::EmulateBBA.override(false);
+	config::UseDCNet.override(false);
+	config::EnableUPnP.override(false);
+	// GGPO always drives port B as player 2: both machines need a controller
+	// there (the frontend only plugs port A)
+	retro_set_controller_port_device(1, RETRO_DEVICE_JOYPAD);
+	NOTICE_LOG(NETWORK, "NX GGPO: %s, server '%s', delay %d, %s BIOS", config::ActAsServer ? "host" : "client",
+			config::NetworkServer.get().c_str(), config::GGPODelay.get(), config::UseReios ? "HLE" : "real");
+	return true;
+}
+static bool nx_ggpo_start()
+{
+	if (NetworkHandshake::instance == nullptr)
+	{
+		ERROR_LOG(NETWORK, "NX GGPO: no network handshake after load");
+		return false;
+	}
+	const char *t = getenv("NX_GGPO_TIMEOUT");
+	int timeout = t != nullptr && atoi(t) > 0 ? atoi(t) : 60;
+	std::future<bool> status = NetworkHandshake::instance->start();
+	if (status.wait_for(std::chrono::seconds(timeout)) != std::future_status::ready)
+	{
+		ERROR_LOG(NETWORK, "NX GGPO: peer not synchronized after %d s", timeout);
+		NetworkHandshake::instance->stop();
+		return false;
+	}
+	try {
+		if (!status.get())
+		{
+			ERROR_LOG(NETWORK, "NX GGPO: handshake failed");
+			return false;
+		}
+	} catch (const FlycastException& e) {
+		ERROR_LOG(NETWORK, "NX GGPO: %s", e.what());
+		return false;
+	}
+	NOTICE_LOG(NETWORK, "NX GGPO: synchronized with peer");
+	return true;
+}
+#endif
