 #include <ctime>
 #include <thread>
 #include <chrono>
+#ifndef _WIN32
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+// NX Redux: a renamed card is on disk (fsync) before the old file goes
+static bool nxSyncToDisk(FILE *f)
+{
+#ifndef _WIN32
+	return fsync(fileno(f)) == 0;
+#else
+	return true;
+#endif
+}
+
+// NX Redux: a moved card keeps the old file's modification time, so sync's
+// newer-wins compares when it was last played, not when it was moved
+static void nxKeepMtime(const std::string& from, const std::string& to)
+{
+#ifdef __linux__
+	struct stat st;
+	if (stat(from.c_str(), &st) == 0)
+	{
+		struct timespec times[2] = { st.st_atim, st.st_mtim };
+		utimensat(AT_FDCWD, to.c_str(), times, 0);
+	}
+#endif
+}
 
