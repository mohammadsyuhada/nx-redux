+
+// NX Redux: copies a card to a new path through a temp file (synced, then renamed, so a half-copied card never
+// shows up) and gives it the old file's modification time, so sync's newer-wins compares when it was last
+// played, not when it was moved. The old file is left in place.
+static bool nxCopyCard(const std::string& from, const std::string& to)
+{
+	std::string tmp = to + ".tmp";
+	bool ok = false;
+	FILE *in = fopen(from.c_str(), "rb");
+	FILE *out = in != nullptr ? fopen(tmp.c_str(), "wb") : nullptr;
+	if (out != nullptr)
+	{
+		char buf[16384];
+		size_t n;
+		ok = true;
+		while ((n = fread(buf, 1, sizeof(buf), in)) > 0)
+			if (fwrite(buf, 1, n, out) != n)
+				ok = false;
+		if (ferror(in) || fflush(out) != 0)
+			ok = false;
+#ifndef _WIN32
+		if (ok && fsync(fileno(out)) != 0)
+			ok = false;
+#endif
+		if (fclose(out) != 0)
+			ok = false;
+	}
+	if (in != nullptr)
+		fclose(in);
+	if (ok && rename(tmp.c_str(), to.c_str()) == 0)
+	{
+#ifdef __linux__
+		struct stat st;
+		if (stat(from.c_str(), &st) == 0)
+		{
+			struct timespec times[2] = { st.st_atim, st.st_mtim };
+			utimensat(AT_FDCWD, to.c_str(), times, 0);
+		}
+#endif
+		return true;
+	}
+	remove(tmp.c_str());
+	return false;
 }
 
