+// The wire carries 2-byte messages both ways; Nagle would happily sit on one
+// waiting for more. Harmless in strict request/reply alternation, harmful the
+// moment the cadence slips — and free to turn off.
+void NetSerial::configureSocket(int fd)
+{
+	int nodelay = 1;
+	setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &nodelay, sizeof(nodelay));
+}
