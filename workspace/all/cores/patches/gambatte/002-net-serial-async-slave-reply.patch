+void NetSerial::startServiceThread()
+{
+	if (service_running_) {
+		return;
+	}
+	service_stop_ = false;
+	if (pthread_create(&service_thread_, NULL, serviceThreadEntry, this) == 0) {
+		service_running_ = true;
+	} else {
+		gambatte_log(RETRO_LOG_ERROR, "GameLink: could not start link service thread: %s\n",
+				strerror(errno));
+	}
+}
+
+void NetSerial::stopServiceThread()
+{
+	if (!service_running_) {
+		return;
+	}
+	service_stop_ = true;
+	pthread_join(service_thread_, NULL);
+	service_running_ = false;
+}
+
+void* NetSerial::serviceThreadEntry(void* self)
+{
+	((NetSerial*)self)->serviceLoop();
+	return NULL;
+}
+
+void NetSerial::serviceLoop()
+{
+	while (!service_stop_) {
+		pthread_mutex_lock(&sock_mutex_);
+
+		// A waiting client gets accepted here, not on the emulation's
+		// schedule: the old path only accepted from check()'s serial polls,
+		// throttled by a clock() (CPU-time!) 5s gate, so a joining peer
+		// could sit unanswered for many wall-clock seconds.
+		if (!is_stopped_ && is_server_ && server_fd_ >= 0 && sockfd_ < 0) {
+			acceptClient();
+		}
+
+		// Drain every complete request waiting on the socket. Non-blocking
+		// throughout: FIONREAD says how much is really there.
+		while (!is_stopped_ && sockfd_ >= 0) {
+			int bytes_avail = 0;
+			if (ioctl(sockfd_, FIONREAD, &bytes_avail) < 0) {
+				gambatte_log(RETRO_LOG_ERROR, "IOCTL Failed: %s\n", strerror(errno));
+				break;
+			}
+			if (bytes_avail < 2) {
+				break;
+			}
+
+			unsigned char buffer[2];
+			if (read(sockfd_, buffer, 2) <= 0) {
+				gambatte_log(RETRO_LOG_ERROR, "Error reading from socket: %s\n", strerror(errno));
+				close(sockfd_);
+				sockfd_ = -1;
+				break;
+			}
+
+			// A reply that arrived after its send() gave up: consume it
+			// silently or the two service threads would ping-pong forever.
+			if (expect_stale_reply_) {
+				expect_stale_reply_ = false;
+				continue;
+			}
+
+			// Queue the master's byte for the emulation's next check() poll —
+			// the same moment the old code would have delivered it. Latest
+			// data wins on overflow, like a hardware SB overwrite.
+			if (rx_count_ == RX_QUEUE_MAX) {
+				rx_head_ = (rx_head_ + 1) % RX_QUEUE_MAX;
+				rx_count_--;
+			}
+			int slot = (rx_head_ + rx_count_) % RX_QUEUE_MAX;
+			rx_data_[slot] = buffer[0];
+			rx_fast_[slot] = buffer[1];
+			rx_count_++;
+
+			// Answer NOW with the cached SB byte — the whole point.
+			buffer[0] = cached_out_;
+			buffer[1] = 128;
+			if (write(sockfd_, buffer, 2) <= 0) {
+				gambatte_log(RETRO_LOG_ERROR, "Error writing to socket: %s\n", strerror(errno));
+				close(sockfd_);
+				sockfd_ = -1;
+				break;
+			}
+		}
+
+		pthread_mutex_unlock(&sock_mutex_);
+		usleep(SERVICE_POLL_US);
+	}
+}
