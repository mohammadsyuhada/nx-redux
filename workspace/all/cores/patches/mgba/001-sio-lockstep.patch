+#ifdef M_CORE_GBA
+/* NXRedux: a real link cable between two mGBA instances over netplay
+ * (frontend netpacket; minarch routes it over the USB Cable). The GBA SIO
+ * driver lives in src/gba/sio/nx_lockstep.c. Outside a netpacket session no
+ * driver is installed and the core behaves as before. */
+static void np_io_send(const void* buf, size_t len) {
+	if (np_send) {
+		np_send(RETRO_NETPACKET_RELIABLE | RETRO_NETPACKET_FLUSH_HINT, buf, len, RETRO_NETPACKET_BROADCAST);
+	}
+}
+
+static void np_io_poll(void) {
+	if (np_poll) {
+		np_poll();
+	}
+}
+
+static void RETRO_CALLCONV np_start(uint16_t client_id, retro_netpacket_send_t send_fn, retro_netpacket_poll_receive_t poll_receive_fn) {
+	np_send = send_fn;
+	np_poll = poll_receive_fn;
+	np_client_id = client_id;
+	np_peer = false;
+	nx_lockstep_attach(core->board, np_io_send, np_io_poll);
+	/* A client only starts once it is connected; the host links when its
+	 * client connects (np_connected), not while it waits for one. */
+	if (client_id != 0) {
+		nx_lockstep_start(false);
+	}
+}
+
+static void RETRO_CALLCONV np_receive(const void* buf, size_t len, uint16_t client_id) {
+	UNUSED(client_id);
+	nx_lockstep_receive(buf, len);
+}
+
+static void RETRO_CALLCONV np_stop(void) {
+	if (np_send) { /* not after retro_unload_game already detached */
+		nx_lockstep_detach(core->board);
+	}
+	np_send = NULL;
+	np_poll = NULL;
+	np_peer = false;
+}
+
+static bool RETRO_CALLCONV np_connected(uint16_t client_id) {
+	if (np_peer) {
+		return false;
+	}
+	np_peer = true;
+	np_peer_id = client_id;
+	/* Host only: the cable is plugged in now. The frontend reports the peer
+	 * as connected on the client side too, right after start(), and a second
+	 * start there would make both sides timeline leaders. */
+	if (np_client_id == 0) {
+		nx_lockstep_start(true);
+	}
+	return true;
+}
+
+static void RETRO_CALLCONV np_disconnected(uint16_t client_id) {
+	if (!np_peer || client_id != np_peer_id) {
+		return;
+	}
+	np_peer = false;
+	nx_lockstep_stop();
+}
+
+static const struct retro_netpacket_callback np_iface = {
+	np_start,
+	np_receive,
+	np_stop,
+	NULL, /* poll */
+	np_connected,
+	np_disconnected,
+	"nx-mgba-lockstep-1",
+};
+#endif
+
