+/* nx-redux: GLideN64's load progress (hi-res pack conversion, cache load).
+ * The text goes to the frontend as a progress message; at most every 100 ms
+ * a frame is handed over so the frontend can show it. */
+static int nx_in_retro_run = 0;
+
+static unsigned long nx_progress_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long)ts.tv_sec * 1000UL + (unsigned long)(ts.tv_nsec / 1000000L);
+}
+
+int nx_load_progress(const char* text)
+{
+    static unsigned long last_frame;
+    char msg[512];
+    struct retro_message_ext m;
+    unsigned long now = nx_progress_ms();
+
+    if (strstr(text, "total mem:"))
+        snprintf(msg, sizeof(msg), "Processing hi-res textures (first time only)...\n%s", text);
+    else
+        snprintf(msg, sizeof(msg), "%s", text);
+    memset(&m, 0, sizeof(m));
+    m.msg      = msg;
+    m.duration = 1000;
+    m.priority = 3;
+    m.level    = RETRO_LOG_INFO;
+    m.target   = RETRO_MESSAGE_TARGET_OSD;
+    m.type     = RETRO_MESSAGE_TYPE_PROGRESS;
+    m.progress = -1;
+    environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, &m);
+
+    if (now - last_frame < 100)
+        return 0;
+    last_frame = now;
+    return 1;
+}
+
+/* The progress frame was swapped: with the threaded renderer that already
+ * returns to the frontend; on the libretro thread, return from retro_run
+ * here (only from inside it, never during teardown). */
+void nx_load_progress_yield(void)
+{
+    if (nx_in_retro_run && !(current_rdp_type == RDP_PLUGIN_GLIDEN64 && EnableThreadedRenderer))
+        co_switch(retro_thread);
+}
+
 static void* EmuThreadFunction(void* param)
 {
     initializing = false;
