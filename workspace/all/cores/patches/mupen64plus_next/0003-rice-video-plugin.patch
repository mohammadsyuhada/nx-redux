diff --git a/custom/mupen64plus-core/plugin/rice_glue.c b/custom/mupen64plus-core/plugin/rice_glue.c
new file mode 100644
index 0000000..73f236d
--- /dev/null
+++ b/custom/mupen64plus-core/plugin/rice_glue.c
@@ -0,0 +1,93 @@
+/* nx-redux: glue between the mupen64plus-next core and the Rice video
+ * plugin built into it (HAVE_RICE).
+ *
+ * Rice's PluginStartup looks up the core's config and video-extension
+ * functions by name, as it would in a separate .so. Inside the core there
+ * is no library to search, so rice_core_proc() hands out the addresses.
+ * Rice's own globals with the same names stay local to its object
+ * (build-rice.sh), so they cannot collide with these functions. */
+#include <stdio.h>
+#include <string.h>
+
+#define M64P_CORE_PROTOTYPES 1
+#include "api/m64p_types.h"
+#include "api/m64p_common.h"
+#include "api/m64p_config.h"
+#include "api/m64p_vidext.h"
+
+#include "main/version.h"
+
+#include <glsm/glsm.h>
+
+EXPORT m64p_error CALL ricePluginStartup(m64p_dynlib_handle, void*, void (*)(void*, int, const char*));
+
+/* api/common.c is not part of the libretro build: answer Rice's API
+ * version check with the core's own versions. */
+static m64p_error rice_api_versions(int* config, int* debug, int* vidext, int* extra)
+{
+   if (config) *config = CONFIG_API_VERSION;
+   if (debug) *debug = DEBUG_API_VERSION;
+   if (vidext) *vidext = VIDEXT_API_VERSION;
+   if (extra) *extra = 0;
+   return M64ERR_SUCCESS;
+}
+
+/* The libretro vidext has no GL proc lookup or attribute query: glsm owns
+ * GL, and Rice only asks for attributes to log them. */
+static void* rice_gl_get_proc(const char* name)
+{
+   return glsm_get_proc_address(name);
+}
+
+static m64p_error rice_gl_get_attr(m64p_GLattr attr, int* value)
+{
+   (void)attr;
+   if (value)
+      *value = 0;
+   return M64ERR_SUCCESS;
+}
+
+#define P(f) { #f, (void*)f }
+static const struct { const char* name; void* addr; } rice_procs[] = {
+   { "CoreGetAPIVersions", (void*)rice_api_versions },
+   P(ConfigOpenSection), P(ConfigSetParameter), P(ConfigSetParameterHelp), P(ConfigGetParameter),
+   P(ConfigSetDefaultInt), P(ConfigSetDefaultFloat), P(ConfigSetDefaultBool), P(ConfigSetDefaultString),
+   P(ConfigGetParamInt), P(ConfigGetParamFloat), P(ConfigGetParamBool), P(ConfigGetParamString),
+   P(ConfigGetSharedDataFilepath), P(ConfigGetUserConfigPath), P(ConfigGetUserDataPath), P(ConfigGetUserCachePath),
+   P(VidExt_Init), P(VidExt_Quit), P(VidExt_ListFullscreenModes), P(VidExt_SetVideoMode),
+   P(VidExt_SetCaption), P(VidExt_ToggleFullScreen), P(VidExt_ResizeWindow),
+   P(VidExt_GL_SetAttribute), P(VidExt_GL_SwapBuffers),
+   { "VidExt_GL_GetProcAddress", (void*)rice_gl_get_proc },
+   { "VidExt_GL_GetAttribute", (void*)rice_gl_get_attr },
+};
+
+void* rice_core_proc(const char* name)
+{
+   size_t i;
+   for (i = 0; i < sizeof(rice_procs) / sizeof(rice_procs[0]); i++)
+      if (!strcmp(rice_procs[i].name, name))
+         return rice_procs[i].addr;
+   printf("[Rice] no core function %s\n", name);
+   return NULL;
+}
+
+static void rice_debug(void* context, int level, const char* message)
+{
+   (void)context;
+   if (level <= M64MSG_WARNING)
+      printf("[Rice] %s\n", message);
+}
+
+void ConfigInitInMemory(void);
+
+void rice_plugin_startup(void)
+{
+   static int started;
+   if (started)
+      return;
+   ConfigInitInMemory();
+   if (ricePluginStartup(NULL, NULL, rice_debug) == M64ERR_SUCCESS)
+      started = 1;
+   else
+      printf("[Rice] PluginStartup failed\n");
+}
