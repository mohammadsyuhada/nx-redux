@@ -625,6 +634,17 @@ static m64p_error ParseCommandLineMain(int argc, const char **argv)
                 (*ConfigSetParameter)(l_ConfigVideo, "ScreenHeight", M64TYPE_INT, &yres);
             }
         }
+        else if (strcmp(argv[i], "--netplay") == 0 && ArgsLeft >= 2)
