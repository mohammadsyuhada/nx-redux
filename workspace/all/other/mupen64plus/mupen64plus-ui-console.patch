+static const char *l_NetplayHost = NULL;    // netplay server hostname/IP
+static int         l_NetplayPort = 0;       // netplay server port
+static int         l_NetplayPlayer = 0;     // player seat to request (1-4)
+static int         l_NetplayActive = 0;     // netplay session established
+
 static eCheatMode l_CheatMode = CHEAT_DISABLE;
 static char      *l_CheatNumList = NULL;
 
@@ -367,6 +374,8 @@ static void printUsage(const char *progname)
            "    --fullscreen           : use fullscreen display mode\n"
