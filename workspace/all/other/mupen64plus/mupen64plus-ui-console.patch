         else if (strcmp(argv[i], "--cheats") == 0 && ArgsLeft >= 1)
         {
             if (strcmp(argv[i+1], "all") == 0)
@@ -987,6 +1007,17 @@ int main(int argc, char *argv[])
         return 6;
     }
 
+    /* validate netplay command-line options */
+    if (l_NetplayHost != NULL &&
+        (l_NetplayPort < 1 || l_NetplayPort > 65535 ||
+         l_NetplayPlayer < 1 || l_NetplayPlayer > 4))
+    {
+        DebugMessage(M64MSG_ERROR, "--netplay requires a valid port and --netplay-player 1-4");
+        printUsage(argv[0]);
+        DetachCoreLib();
+        return 6;
+    }
+
     /* save the given command-line options in configuration file if requested */
     if (l_SaveOptions)
         SaveConfigurationOptions();
@@ -1135,9 +1166,76 @@ int main(int argc, char *argv[])
     if (l_SaveOptions && (*ConfigHasUnsavedChanges)(NULL))
         (*ConfigSaveFile)();
 
+    /* set up netplay session if requested */
+#define UI_NETPLAY_API_VERSION 0x010001  /* NETPLAY_API_VERSION, core src/main/version.h */
+
+    if (l_NetplayHost != NULL)
+    {
+        uint32_t netplay_version = 0;
+        m64p_error rval;
+        int attempt;
+
+        if ((*CoreDoCommand)(M64CMD_NETPLAY_GET_VERSION, UI_NETPLAY_API_VERSION,
+                             &netplay_version) != M64ERR_SUCCESS)
+        {
+            DebugMessage(M64MSG_ERROR, "netplay API version mismatch (core: %08x, ui: %08x)",
+                         netplay_version, UI_NETPLAY_API_VERSION);
+            (*CoreDoCommand)(M64CMD_ROM_CLOSE, 0, NULL);
+            (*CoreShutdown)();
+            DetachCoreLib();
+            return 15;
+        }
+
+        /* the peer's server may start a moment after us: retry for ~10 s */
+        rval = M64ERR_SYSTEM_FAIL;
+        for (attempt = 0; attempt < 20; ++attempt)
+        {
+            rval = (*CoreDoCommand)(M64CMD_NETPLAY_INIT, l_NetplayPort,
+                                    (void *) l_NetplayHost);
+            if (rval == M64ERR_SUCCESS)
+                break;
+            usleep(500000);
+        }
+        if (rval != M64ERR_SUCCESS)
+        {
+            DebugMessage(M64MSG_ERROR, "netplay: could not connect to %s:%d",
+                         l_NetplayHost, l_NetplayPort);
+            (*CoreDoCommand)(M64CMD_ROM_CLOSE, 0, NULL);
+            (*CoreShutdown)();
+            DetachCoreLib();
+            return 16;
+        }
+
+        uint32_t reg_id = (((uint32_t) time(NULL)) << 8)
+                        ^ ((uint32_t) getpid())
+                        ^ ((uint32_t) l_NetplayPlayer);
+        if (reg_id == 0)
+            reg_id = 0x4E585250;  /* reg_id 0 means "empty seat" on the wire */
+
+        if ((*CoreDoCommand)(M64CMD_NETPLAY_CONTROL_PLAYER, l_NetplayPlayer,
+                             &reg_id) != M64ERR_SUCCESS)
+        {
+            DebugMessage(M64MSG_ERROR, "netplay: player %d seat rejected by server",
+                         l_NetplayPlayer);
+            (*CoreDoCommand)(M64CMD_NETPLAY_CLOSE, 0, NULL);
+            (*CoreDoCommand)(M64CMD_ROM_CLOSE, 0, NULL);
+            (*CoreShutdown)();
+            DetachCoreLib();
+            return 17;
+        }
+
+        l_NetplayActive = 1;
+        DebugMessage(M64MSG_INFO, "netplay: connected to %s:%d as player %d",
+                     l_NetplayHost, l_NetplayPort, l_NetplayPlayer);
+    }
+
     /* run the game */
     (*CoreDoCommand)(M64CMD_EXECUTE, 0, NULL);
 
+    /* close netplay session if one was established */
+    if (l_NetplayActive)
+        (*CoreDoCommand)(M64CMD_NETPLAY_CLOSE, 0, NULL);
+
     /* detach plugins from core and unload them */
     for (i = 0; i < 4; i++)
         (*CoreDetachPlugin)(g_PluginMap[i].type);
