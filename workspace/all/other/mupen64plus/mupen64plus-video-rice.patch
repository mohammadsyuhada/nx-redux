+# --- nx-redux in-game overlay menu (shared sources) ----------------------
+# The overlay is compiled INTO the plugin, the same way it is into GLideN64
+# (see workspace/all/other/mupen64plus/README.md). nx_overlay.cpp lives in
+# $(SRCDIR) and rides the normal .cpp rule above; the shared C sources live
+# out-of-tree in workspace/all/common and get their own object subdir +
+# pattern rule below. OVERLAY_DIR resolves to workspace/all/common from either
+# platform checkout ($(SRCDIR) = <rice>/src, five levels under workspace/).
+OVERLAY_DIR = $(SRCDIR)/../../../../../all/common
+CFLAGS += -I$(OVERLAY_DIR)
+LDLIBS += -lSDL2_ttf -lSDL2_image
+
+OVERLAY_SOURCE = \
+	$(OVERLAY_DIR)/emu_overlay.c \
+	$(OVERLAY_DIR)/emu_overlay_cfg.c \
+	$(OVERLAY_DIR)/emu_overlay_sdl.c \
+	$(OVERLAY_DIR)/text_shape.c \
+	$(OVERLAY_DIR)/cjson/cJSON.c
+
 # generate a list of object files build, make a temporary directory for them
 OBJECTS := $(patsubst $(SRCDIR)/%.c, $(OBJDIR)/%.o, $(filter %.c, $(SOURCE)))
 OBJECTS += $(patsubst $(SRCDIR)/%.cpp, $(OBJDIR)/%.o, $(filter %.cpp, $(SOURCE)))
+# out-of-tree overlay .c sources compile into $(OBJDIR)/overlay/ (own rule below)
+OBJECTS += $(patsubst $(OVERLAY_DIR)/%.c, $(OBJDIR)/overlay/%.o, $(OVERLAY_SOURCE))
 OBJDIRS = $(dir $(OBJECTS))
 $(shell $(MKDIR) $(OBJDIRS))
 
@@ -449,6 +470,10 @@ $(OBJDIR)/%.o: $(SRCDIR)/%.c
 $(OBJDIR)/%.o: $(SRCDIR)/%.cpp
 	$(COMPILE.cc) -o $@ $<
 
+# out-of-tree nx-redux overlay C sources (workspace/all/common)
+$(OBJDIR)/overlay/%.o: $(OVERLAY_DIR)/%.c
+	$(COMPILE.c) -o $@ $<
+
 $(TARGET): $(OBJECTS)
 	$(LINK.o) $^ $(LOADLIBES) $(LDLIBS) -o $@
 
