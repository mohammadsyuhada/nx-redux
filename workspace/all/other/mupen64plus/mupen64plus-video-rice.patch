--- /dev/null
+++ b/src/nx_overlay.cpp
@@ -0,0 +1,279 @@
+// nx_overlay.cpp — nx-redux in-game overlay hook, Rice port.
+//
+// This is a straight port of GLideN64's overlay integration
+// (GLideN64-standalone.patch, src/DisplayWindow.cpp) with two adaptations:
+//   * Rice is single-threaded, so only GLideN64's NON-threaded branch is kept
+//     (no OpenGlCommand dispatch to a video thread — every call runs here, on
+//     the emu thread that also drives the plugin).
+//   * The GL work goes through the shared SDL overlay backend
+//     (overlay_sdl_get_backend(), the same one flycast/desktop use) instead of
+//     GLideN64's own OverlayGL backend.
+// State commands go through g_nxCoreDoCommand (resolved in PluginStartup, may
+// be NULL — then state actions are skipped). Behaviour is otherwise identical
+// to the GLideN64 hook; keep the two in sync.
+
+#include "nx_overlay.h"
+
+#include <SDL2/SDL.h>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <initializer_list> // range-for over {0,1,4,5,8} below
+
+// ptr_CoreDoCommand + the M64CMD_* command enum.
+#include "m64p_frontend.h"
+// CoreVideo_GL_SwapBuffers (core video-extension function pointer).
+#include "Video.h"
+
+extern "C" {
+#include "emu_overlay.h"
+#include "emu_overlay_cfg.h"
+#include "emu_overlay_sdl.h"
+}
+
+// Resolved in Video.cpp::PluginStartup via osal_dynlib_getproc(...,
+// "CoreDoCommand"). NULL-tolerant: state save/load/stop are skipped when unset.
+extern ptr_CoreDoCommand g_nxCoreDoCommand;
+
+// ---------------------------------------------------------------------------
+// Overlay state
+// ---------------------------------------------------------------------------
+
+static EmuOvl s_overlay;
+static EmuOvlConfig s_overlayConfig;
+static bool s_overlayInitialized = false;
+static bool s_overlayConfigLoaded = false;
+static bool s_overlayConfigFailed = false;
+static char s_overlayJsonPath[512] = "";
+static char s_overlayIniPath[512] = "";
+static bool s_menuBtnPrev = false;
+static SDL_Joystick* s_joy = nullptr;
+static Uint8 s_prevHat = 0;
+static Uint32 s_prevButtons = 0;
+static bool s_resumeChecked = false;
+// Quit-with-autosave sequencing: M64CMD_STATE_SAVE is queued and serviced at
+// the next interrupt on the emu thread, so after requesting the auto-slot save
+// we let emulation run a few more frames before issuing M64CMD_STOP — stopping
+// in the same breath could tear the loop down before the save job runs.
+static bool s_quitPending = false;
+static int s_quitDelayFrames = 0;
+
+// ---------------------------------------------------------------------------
+// Overlay helpers
+// ---------------------------------------------------------------------------
+
+static void overlay_init_paths()
+{
+	const char* json = getenv("EMU_OVERLAY_JSON");
+	const char* ini  = getenv("EMU_OVERLAY_INI");
+	if (json) strncpy(s_overlayJsonPath, json, sizeof(s_overlayJsonPath) - 1);
+	if (ini)  strncpy(s_overlayIniPath,  ini,  sizeof(s_overlayIniPath) - 1);
+}
+
+static void overlay_ensure_init(int w, int h)
+{
+	if (s_overlayInitialized || s_overlayConfigFailed)
+		return;
+
+	// Load config once (permanent failure if config file is bad)
+	if (!s_overlayConfigLoaded) {
+		overlay_init_paths();
+
+		if (s_overlayJsonPath[0] == '\0')
+			return; // no overlay config provided — no-op, retry next frame
+
+		memset(&s_overlayConfig, 0, sizeof(s_overlayConfig));
+		if (emu_ovl_cfg_load(&s_overlayConfig, s_overlayJsonPath) != 0) {
+			fprintf(stderr, "[Overlay] Failed to load config: %s\n", s_overlayJsonPath);
+			s_overlayConfigFailed = true;
+			return;
+		}
+
+		if (s_overlayIniPath[0] != '\0') {
+			emu_ovl_cfg_read_ini(&s_overlayConfig, s_overlayIniPath);
+		}
+
+		s_overlayConfigLoaded = true;
+	}
+
+	// Try GL init on this (the plugin/emu) thread — retries each frame until
+	// the GL context is available.
+	EmuOvlRenderBackend* render = overlay_sdl_get_backend();
+	if (render->init(w, h) != 0)
+		return; // GL not ready yet, will retry next frame
+
+	const char* gameName = getenv("EMU_OVERLAY_GAME");
+	emu_ovl_init(&s_overlay, &s_overlayConfig, render,
+	             gameName ? gameName : "N64", w, h);
+
+	s_overlayInitialized = true;
+	fprintf(stderr, "[Overlay] Initialized successfully (%dx%d)\n", w, h);
+}
+
+static bool check_menu_button()
+{
+	SDL_JoystickUpdate();
+
+	if (!s_joy) {
+		if (SDL_NumJoysticks() > 0)
+			s_joy = SDL_JoystickOpen(0);
+		if (!s_joy)
+			return false;
+	}
+
+	bool pressed = SDL_JoystickGetButton(s_joy, 8) != 0;
+	bool justPressed = pressed && !s_menuBtnPrev;
+	s_menuBtnPrev = pressed;
+	return justPressed;
+}
+
+static Uint8 read_dpad_state()
+{
+	// Merge the d-pad hat with the analog stick (axes 0/1): on the Brick the FN
+	// switch reroutes the d-pad to the stick axes (for analog steering), which
+	// would otherwise leave the menu unnavigable.
+	Uint8 dir = SDL_JoystickGetHat(s_joy, 0);
+	const Sint16 T = 16384;
+	Sint16 ax = SDL_JoystickGetAxis(s_joy, 0);
+	Sint16 ay = SDL_JoystickGetAxis(s_joy, 1);
+	if (ay < -T) dir |= SDL_HAT_UP;
+	if (ay >  T) dir |= SDL_HAT_DOWN;
+	if (ax < -T) dir |= SDL_HAT_LEFT;
+	if (ax >  T) dir |= SDL_HAT_RIGHT;
+	return dir;
+}
+
+static EmuOvlInput poll_overlay_input()
+{
+	EmuOvlInput input;
+	memset(&input, 0, sizeof(input));
+
+	// Direct state polling instead of SDL events — SDL_PollEvent() may not
+	// deliver joystick events reliably from the plugin context.
+	SDL_JoystickUpdate();
+	if (!s_joy) return input;
+
+	// D-pad (hat) or analog stick — edge detect: only trigger on newly-pressed directions
+	Uint8 hat = read_dpad_state();
+	Uint8 hatPressed = hat & ~s_prevHat;
+	s_prevHat = hat;
+
+	if (hatPressed & SDL_HAT_UP)    input.up    = true;
+	if (hatPressed & SDL_HAT_DOWN)  input.down  = true;
+	if (hatPressed & SDL_HAT_LEFT)  input.left  = true;
+	if (hatPressed & SDL_HAT_RIGHT) input.right = true;
+
+	// Buttons — edge detect: only trigger on newly-pressed buttons
+	// SDL button indices: 0=A(hw), 1=B(hw), 4=L1, 5=R1, 8=Menu
+	static const int btnMap[] = {0, 1, 4, 5, 8};
+	Uint32 curButtons = 0;
+	for (int i = 0; i < 5; i++) {
+		if (SDL_JoystickGetButton(s_joy, btnMap[i]))
+			curButtons |= (1u << btnMap[i]);
+	}
+	Uint32 btnPressed = curButtons & ~s_prevButtons;
+	s_prevButtons = curButtons;
+
+	if (btnPressed & (1u << 0)) input.b    = true;
+	if (btnPressed & (1u << 1)) input.a    = true;
+	if (btnPressed & (1u << 4)) input.l1   = true;
+	if (btnPressed & (1u << 5)) input.r1   = true;
+	if (btnPressed & (1u << 8)) input.menu = true;
+
+	return input;
+}
+
+// Blocking overlay loop (non-threaded): everything runs here on the emu thread.
+static EmuOvlAction run_overlay_loop()
+{
+	// Pause audio while the menu is up.
+	SDL_PauseAudio(1);
+
+	emu_ovl_open(&s_overlay);
+
+	// Reset input edge detection state and drain pending SDL events.
+	s_prevHat = read_dpad_state();
+	s_prevButtons = 0;
+	for (int i : {0, 1, 4, 5, 8}) {
+		if (SDL_JoystickGetButton(s_joy, i))
+			s_prevButtons |= (1u << i);
+	}
+	SDL_Event ev;
+	while (SDL_PollEvent(&ev)) {}
+	s_menuBtnPrev = true; // prevent re-trigger
+
+	while (emu_ovl_is_active(&s_overlay)) {
+		EmuOvlInput input = poll_overlay_input();
+		emu_ovl_update(&s_overlay, &input);
+		emu_ovl_render(&s_overlay);
+		CoreVideo_GL_SwapBuffers();
+		SDL_Delay(16);
+	}
+
+	SDL_PauseAudio(0);
+
+	return emu_ovl_get_action(&s_overlay);
+}
+
+// ---------------------------------------------------------------------------
+// Public hook — called from COGLGraphicsContext::UpdateFrame() before the swap
+// ---------------------------------------------------------------------------
+
+void nx_overlay_before_swap(int w, int h)
+{
+	// Rice has no hi-res load-progress phase, so (unlike GLideN64) there is no
+	// isLoadProgressActive() gate to skip here.
+	overlay_ensure_init(w, h);
+
+	// One-shot: if NxRedux launched us with a resume request (game switcher
+	// A-press writes the slot to /tmp/resume_slot.txt), auto-load that save
+	// state once emulation is rendering frames — mirrors minarch's
+	// State_resume side of the handshake.
+	if (s_overlayInitialized && !s_resumeChecked) {
+		s_resumeChecked = true;
+		int resumeSlot = emu_ovl_consume_resume_slot();
+		if (resumeSlot >= 0 && g_nxCoreDoCommand) {
+			g_nxCoreDoCommand(M64CMD_STATE_SET_SLOT, resumeSlot, nullptr);
+			g_nxCoreDoCommand(M64CMD_STATE_LOAD, 0, nullptr);
+		}
+	}
+
+	if (s_quitPending) {
+		// Auto-save requested by QUIT below: give the queued save job a few
+		// frames to be serviced, then stop for real.
+		if (--s_quitDelayFrames <= 0) {
+			s_quitPending = false;
+			if (g_nxCoreDoCommand)
+				g_nxCoreDoCommand(M64CMD_STOP, 0, nullptr);
+		}
+	} else if (s_overlayInitialized && check_menu_button()) {
+		EmuOvlAction action = run_overlay_loop();
+		if (action == EMU_OVL_ACTION_QUIT) {
+			if (g_nxCoreDoCommand) {
+				// Auto-save to the hidden auto-resume slot so the game switcher
+				// always resumes at the exact quit moment — parity with
+				// DC.pak's quit and minarch's Menu_autosaveQuit. Screenshot +
+				// .minui slot-file repoint happen here; the state itself is
+				// written by the queued job a frame or two later, before the
+				// delayed M64CMD_STOP above.
+				g_nxCoreDoCommand(M64CMD_STATE_SET_SLOT, EMU_OVL_AUTO_SLOT, nullptr);
+				g_nxCoreDoCommand(M64CMD_STATE_SAVE, 1, nullptr);
+				emu_ovl_save_slot_screenshot(&s_overlay, EMU_OVL_AUTO_SLOT);
+				s_quitPending = true;
+				s_quitDelayFrames = 3;
+			}
+		} else if (action == EMU_OVL_ACTION_SAVE_STATE) {
+			int slot = emu_ovl_get_action_param(&s_overlay);
+			if (g_nxCoreDoCommand) {
+				g_nxCoreDoCommand(M64CMD_STATE_SET_SLOT, slot, nullptr);
+				g_nxCoreDoCommand(M64CMD_STATE_SAVE, 1, nullptr);
+			}
+			emu_ovl_save_slot_screenshot(&s_overlay, slot);
+		} else if (action == EMU_OVL_ACTION_LOAD_STATE) {
+			if (g_nxCoreDoCommand) {
+				g_nxCoreDoCommand(M64CMD_STATE_SET_SLOT, emu_ovl_get_action_param(&s_overlay), nullptr);
+				g_nxCoreDoCommand(M64CMD_STATE_LOAD, 0, nullptr);
+			}
+		}
+	}
+}
diff --git a/src/nx_overlay.h b/src/nx_overlay.h
new file mode 100644
index 0000000..88176f8
--- /dev/null
+++ b/src/nx_overlay.h
@@ -0,0 +1,19 @@
+// nx_overlay.h — nx-redux in-game overlay hook for the Rice video plugin.
+//
+// The overlay menu (Continue / Save State / Load State / Quit, plus the game
+// switcher resume + quit-autosave handshake) is compiled INTO the video
+// plugin, exactly as it is into GLideN64 (see src/DisplayWindow.cpp in
+// GLideN64-standalone.patch, the reference implementation). Rice is
+// single-threaded, so this is the non-threaded branch of that hook driven off
+// the shared SDL overlay backend (overlay_sdl_get_backend()).
+//
+// Declared with plain C++ linkage: the sole caller is
+// COGLGraphicsContext::UpdateFrame(), which is C++ in this plugin.
+#ifndef NX_OVERLAY_H
+#define NX_OVERLAY_H
+
+// Called from COGLGraphicsContext::UpdateFrame() immediately before the buffer
+// swap. w/h are the current display dimensions (windowSetting.uDisplay*).
+void nx_overlay_before_swap(int w, int h);
+
+#endif // NX_OVERLAY_H
