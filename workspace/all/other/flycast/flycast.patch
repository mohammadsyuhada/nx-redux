diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8340288fe..e2b512404 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -312,6 +312,67 @@ if(NINTENDO_SWITCH)
 	target_include_directories(${PROJECT_NAME} PRIVATE shell/switch)
 endif()
 
+# NextUI overlay menu (shared library, lives in the nx-redux workspace).
+# Standalone Linux only (this project builds tg5040/tg5050 standalone
+# targets; LIBRETRO/ANDROID/APPLE/WIN32 builds don't have a nx-redux pak).
+if(NOT LIBRETRO AND NOT ANDROID AND NOT APPLE AND NOT WIN32)
+	set(NX_OVERLAY_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../../common")
+	set(NX_OVERLAY_SOURCES
+		core/nx_overlay.cpp
+		${NX_OVERLAY_DIR}/emu_overlay.c
+		${NX_OVERLAY_DIR}/emu_overlay_cfg.c
+		${NX_OVERLAY_DIR}/emu_overlay_sdl.c
+		${NX_OVERLAY_DIR}/cjson/cJSON.c
+	)
+	target_sources(${PROJECT_NAME} PRIVATE ${NX_OVERLAY_SOURCES})
+	# Deliberately NOT target_include_directories() (target-wide): the
+	# workspace ships its own workspace/all/common/sdl.h shim (used by other
+	# emulator cores, requires -DUSE_SDL2 which flycast doesn't define), and
+	# this Docker bind mount (macOS host -> Linux container) is
+	# case-insensitive, so adding common/ to the whole target's search path
+	# makes every unrelated flycast file's #include <SDL.h> incorrectly
+	# resolve to that shim instead of the real toolchain SDL2 header
+	# (observed: fatal error pulling in nonexistent SDL/SDL_image.h on
+	# tg5050, and a cascade of bogus "begin/end not declared" errors
+	# elsewhere on tg5040). None of the four common/*.c files above actually
+	# need this include dir themselves (they use "quoted" includes for their
+	# own co-located headers, resolved relative to each file regardless of
+	# -I); only nx_overlay.cpp does, for the "emu_overlay*.h" trio. So the
+	# include dir is scoped to just these 5 new files via
+	# set_source_files_properties(), leaving every pre-existing flycast
+	# source's include search path untouched.
+	set_source_files_properties(${NX_OVERLAY_SOURCES}
+		PROPERTIES INCLUDE_DIRECTORIES ${NX_OVERLAY_DIR})
+	# No SDL2_ttf/SDL2_image CMake config or pkg-config module ships in
+	# either toolchain sysroot (only SDL2 itself does, via the cmake-hints
+	# SDL2Config.cmake); both libs' headers/.so are present directly under
+	# the sysroot's usr/include/usr/lib though, which the cross-compiler's
+	# default --sysroot search path already covers, so plain link flags
+	# resolve without any extra -L/-I.
+	# emu_overlay_sdl.c calls GLES3 functions (glCreateShader, glReadPixels,
+	# etc.) directly via <GLES3/gl3.h> rather than through flycast's own
+	# glad/dlopen indirection (that's specific to flycast's main renderer,
+	# for runtime GL-API switching; the overlay doesn't need it), so it
+	# needs an actual link-time GLESv2 library. libGLESv2.so is present in
+	# both toolchain sysroots and is how every other emulator core in this
+	# workspace links GLES (mupen64plus-core, mgba, musicplayer all use
+	# -lGLESv2) - same pattern here.
+	# tg5050's libGLESv2.so is a thin stub whose symbols are actually
+	# defined in libmali.so.0 (the Mali GPU driver blob, usr/lib64); with
+	# GNU ld's default --no-copy-dt-needed-entries, linking -lGLESv2 alone
+	# fails there ("DSO missing from command line") because libmali isn't
+	# on flycast's own link line, only transitively via libGLESv2's NEEDED
+	# entry. tg5040's sysroot has no libmali at all - its libGLESv2.so
+	# defines everything itself and links fine without it. find_library()
+	# rather than an FLYCAST_TOOLCHAIN_PLATFORM check so this adapts
+	# automatically if either sysroot's GL stack shape changes.
+	find_library(NX_OVERLAY_MALI_LIBRARY NAMES mali)
+	target_link_libraries(${PROJECT_NAME} PRIVATE SDL2_ttf SDL2_image GLESv2)
+	if(NX_OVERLAY_MALI_LIBRARY)
+		target_link_libraries(${PROJECT_NAME} PRIVATE ${NX_OVERLAY_MALI_LIBRARY})
+	endif()
+endif()
+
 if(CMAKE_SYSTEM_NAME STREQUAL "OpenBSD")
 	target_link_options(${PROJECT_NAME} PRIVATE "-Wl,--no-execute-only")
 endif()
