diff --git a/core/nx_overlay.cpp b/core/nx_overlay.cpp
new file mode 100644
index 000000000..09d45049f
--- /dev/null
+++ b/core/nx_overlay.cpp
@@ -0,0 +1,312 @@
+#include "nx_overlay.h"
+#include "emulator.h"
+#include "types.h"
+#include "ui/gui.h" // gui_stop_game() - resume-failure fallback (Important 3)
+// Explicit SDL2/ subpath (not <SDL.h>): this file's own -I includes
+// workspace/all/common (for the emu_overlay* headers below), which also
+// hosts nx-redux's own case-insensitively-colliding sdl.h shim (see the
+// CMakeLists.txt comment next to NX_OVERLAY_SOURCES) — <SDL2/SDL.h> has no
+// such ambiguity and matches the toolchain header the rest of flycast uses.
+#include <SDL2/SDL.h>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+
+extern "C" {
+#include "emu_overlay.h"
+#include "emu_overlay_cfg.h"
+#include "emu_overlay_sdl.h"
+}
+
+static EmuOvl s_overlay;
+static EmuOvlConfig s_overlayConfig;
+static bool s_overlayInitialized = false;
+static bool s_overlayConfigLoaded = false;
+static bool s_overlayConfigFailed = false;
+static char s_overlayJsonPath[512] = "";
+static char s_overlayIniPath[512] = "";
+static bool s_menuBtnPrev = false;
+static bool s_menuRequested = false;
+static bool s_menuActive = false;
+static bool s_resumeChecked = false;
+static SDL_Joystick* s_joy = nullptr;
+static Uint8 s_prevHat = 0;
+static Uint32 s_prevButtons = 0;
+
+static void overlay_init_paths()
+{
+	const char* json = getenv("EMU_OVERLAY_JSON");
+	const char* ini  = getenv("EMU_OVERLAY_INI");
+	if (json) strncpy(s_overlayJsonPath, json, sizeof(s_overlayJsonPath) - 1);
+	if (ini)  strncpy(s_overlayIniPath,  ini,  sizeof(s_overlayIniPath) - 1);
+}
+
+static void overlay_ensure_init(int w, int h)
+{
+	if (s_overlayInitialized || s_overlayConfigFailed)
+		return;
+
+	if (!s_overlayConfigLoaded) {
+		overlay_init_paths();
+		if (s_overlayJsonPath[0] == '\0') {
+			s_overlayConfigFailed = true; // no overlay configured for this launch
+			return;
+		}
+		memset(&s_overlayConfig, 0, sizeof(s_overlayConfig));
+		if (emu_ovl_cfg_load(&s_overlayConfig, s_overlayJsonPath) != 0) {
+			fprintf(stderr, "[Overlay] Failed to load config: %s\n", s_overlayJsonPath);
+			s_overlayConfigFailed = true;
+			return;
+		}
+		if (s_overlayIniPath[0] != '\0')
+			emu_ovl_cfg_read_ini(&s_overlayConfig, s_overlayIniPath);
+		s_overlayConfigLoaded = true;
+	}
+
+	// GL init retried each frame until the context exists; we are called on the
+	// thread that owns the GL context (mainui loop).
+	EmuOvlRenderBackend* render = overlay_sdl_get_backend();
+	if (render->init(w, h) != 0)
+		return;
+	const char* gameName = getenv("EMU_OVERLAY_GAME");
+	emu_ovl_init(&s_overlay, &s_overlayConfig, render,
+	             gameName ? gameName : "Dreamcast", w, h);
+	s_overlayInitialized = true;
+	fprintf(stderr, "[Overlay] Initialized successfully (%dx%d)\n", w, h);
+}
+
+// Opens s_joy if it isn't already; returns whether a joystick is available.
+// Shared by check_menu_button() and nx_overlay_after_render() so the latter
+// can refuse to open the menu (rather than open one nothing can navigate or
+// close) when no joystick has ever been found.
+static bool ensure_joystick()
+{
+	if (s_joy)
+		return true;
+	if (SDL_NumJoysticks() > 0)
+		s_joy = SDL_JoystickOpen(0);
+	return s_joy != nullptr;
+}
+
+static bool check_menu_button()
+{
+	SDL_JoystickUpdate();
+	if (!ensure_joystick())
+		return false;
+	bool pressed = SDL_JoystickGetButton(s_joy, 8) != 0;
+	bool justPressed = pressed && !s_menuBtnPrev;
+	s_menuBtnPrev = pressed;
+	return justPressed;
+}
+
+static Uint8 read_dpad_state()
+{
+	// Merge d-pad hat with the analog stick (axes 0/1): the Brick's FN switch
+	// reroutes the d-pad to the stick, which would leave the menu unnavigable.
+	Uint8 dir = SDL_JoystickGetHat(s_joy, 0);
+	const Sint16 T = 16384;
+	Sint16 ax = SDL_JoystickGetAxis(s_joy, 0);
+	Sint16 ay = SDL_JoystickGetAxis(s_joy, 1);
+	if (ay < -T) dir |= SDL_HAT_UP;
+	if (ay >  T) dir |= SDL_HAT_DOWN;
+	if (ax < -T) dir |= SDL_HAT_LEFT;
+	if (ax >  T) dir |= SDL_HAT_RIGHT;
+	return dir;
+}
+
+static EmuOvlInput poll_overlay_input()
+{
+	EmuOvlInput input;
+	memset(&input, 0, sizeof(input));
+	SDL_JoystickUpdate();
+	if (!s_joy) return input;
+
+	Uint8 hat = read_dpad_state();
+	Uint8 hatPressed = hat & ~s_prevHat;
+	s_prevHat = hat;
+	if (hatPressed & SDL_HAT_UP)    input.up    = true;
+	if (hatPressed & SDL_HAT_DOWN)  input.down  = true;
+	if (hatPressed & SDL_HAT_LEFT)  input.left  = true;
+	if (hatPressed & SDL_HAT_RIGHT) input.right = true;
+
+	// SDL button indices: 0=A(hw), 1=B(hw), 4=L1, 5=R1, 8=Menu
+	static const int btnMap[] = {0, 1, 4, 5, 8};
+	Uint32 curButtons = 0;
+	for (int i = 0; i < 5; i++)
+		if (SDL_JoystickGetButton(s_joy, btnMap[i]))
+			curButtons |= (1u << btnMap[i]);
+	Uint32 btnPressed = curButtons & ~s_prevButtons;
+	s_prevButtons = curButtons;
+
+	if (btnPressed & (1u << 0)) input.b    = true;
+	if (btnPressed & (1u << 1)) input.a    = true;
+	if (btnPressed & (1u << 4)) input.l1   = true;
+	if (btnPressed & (1u << 5)) input.r1   = true;
+	if (btnPressed & (1u << 8)) input.menu = true;
+	return input;
+}
+
+static void reset_input_edges()
+{
+	s_prevHat = read_dpad_state();
+	s_prevButtons = 0;
+	for (int i : {0, 1, 4, 5, 8})
+		if (SDL_JoystickGetButton(s_joy, i))
+			s_prevButtons |= (1u << i);
+	s_menuBtnPrev = true; // prevent instant re-trigger
+}
+
+void nx_overlay_request_menu()
+{
+	s_menuRequested = true;
+}
+
+static void handle_menu_close()
+{
+	s_menuActive = false;
+	EmuOvlAction action = emu_ovl_get_action(&s_overlay);
+	switch (action) {
+	case EMU_OVL_ACTION_SAVE_STATE: {
+		int slot = emu_ovl_get_action_param(&s_overlay);
+		// dc_savestate() can throw SerializeBase::Exception (a
+		// std::runtime_error, NOT FlycastException, and unlike
+		// dc_loadstate() it has no internal catch of its own) - a save
+		// hiccup must not skip emu.start() below (permanent stop) or
+		// escape mainui_rend_frame()'s try/catch (which only wraps the
+		// emu.render() branch, not this one -> process terminates).
+		try {
+			dc_savestate(slot);
+			emu_ovl_save_slot_screenshot(&s_overlay, slot);
+		} catch (...) {
+			fprintf(stderr, "[Overlay] Save state failed (slot %d)\n", slot);
+		}
+		emu.start();
+		break;
+	}
+	case EMU_OVL_ACTION_LOAD_STATE: {
+		int slot = emu_ovl_get_action_param(&s_overlay);
+		// dc_loadstate() only catches its own Deserializer::Exception
+		// internally; other exceptions (e.g. from emu.loadstate()) still
+		// propagate, so this needs the same guard as the save path above.
+		try {
+			dc_loadstate(slot);
+		} catch (...) {
+			fprintf(stderr, "[Overlay] Load state failed (slot %d)\n", slot);
+		}
+		emu.start();
+		break;
+	}
+	case EMU_OVL_ACTION_QUIT:
+		// Auto-save so the game switcher can always resume (hidden slot 9).
+		// A throw here must not skip dc_exit() below - the user asked to
+		// quit, and dc_exit() itself is guarded too so quitting can't hang.
+		try {
+			dc_savestate(EMU_OVL_AUTO_SLOT);
+			emu_ovl_save_slot_screenshot(&s_overlay, EMU_OVL_AUTO_SLOT);
+		} catch (...) {
+			fprintf(stderr, "[Overlay] Auto-save-on-quit failed (slot %d)\n", EMU_OVL_AUTO_SLOT);
+		}
+		try {
+			dc_exit();
+		} catch (...) {
+			fprintf(stderr, "[Overlay] dc_exit() threw\n");
+		}
+		break;
+	default: // CONTINUE / NONE
+		emu.start();
+		break;
+	}
+}
+
+bool nx_overlay_frame()
+{
+	int w = settings.display.width;
+	int h = settings.display.height;
+	overlay_ensure_init(w, h);
+	if (!s_overlayInitialized) {
+		s_menuRequested = false;
+		return false;
+	}
+
+	// One-shot game-switcher resume (slot written by nextui's launcher).
+	if (!s_resumeChecked && emu.running()) {
+		s_resumeChecked = true;
+		int slot = emu_ovl_consume_resume_slot();
+		if (slot >= 0) {
+			try {
+				emu.stop();
+			} catch (const FlycastException& e) {
+				// A throwing emu.stop() leaves the emulator in state Error:
+				// emu.start() would refuse and emu.render() would return
+				// false forever, spinning mainui_loop with no swap (frozen
+				// screen, hot CPU). Follow flycast's own convention (see
+				// gui.cpp's gui_loadState()/gui_saveState()) and fall back
+				// to the content browser instead of swallowing this.
+				fprintf(stderr, "[Overlay] Resume: emu.stop() failed (slot %d): %s\n", slot, e.what());
+				gui_stop_game(e.what());
+				return false;
+			} catch (...) {
+				fprintf(stderr, "[Overlay] Resume: emu.stop() failed (slot %d)\n", slot);
+				gui_stop_game("Resume failed");
+				return false;
+			}
+			// dc_loadstate() is inside its own try so a bad/missing resume
+			// slot can't skip emu.start() below and leave the emulator
+			// stopped (stop()/start() must stay paired on every path,
+			// including this failure one).
+			try {
+				dc_loadstate(slot);
+			} catch (...) {
+				fprintf(stderr, "[Overlay] Resume load failed (slot %d)\n", slot);
+			}
+			emu.start();
+		}
+	}
+
+	if (s_menuActive) {
+		// Discard any menu-open signal that arrived while the overlay was
+		// already showing (e.g. a mapped EMU_BTN_MENU press dispatched via
+		// os_UpdateInputState(), independent of s_menuActive) — otherwise it
+		// survives to nx_overlay_after_render() and reopens the menu on the
+		// very next frame after this session closes.
+		s_menuRequested = false;
+		EmuOvlInput input = poll_overlay_input();
+		emu_ovl_update(&s_overlay, &input);
+		emu_ovl_render(&s_overlay);
+		if (!emu_ovl_is_active(&s_overlay))
+			handle_menu_close();
+		return true;
+	}
+
+	// Direct MENU-button polling (mapping-independent, mirrors GLideN64 hook).
+	if (emu.running() && check_menu_button())
+		s_menuRequested = true;
+	return false;
+}
+
+void nx_overlay_after_render()
+{
+	if (!s_menuRequested)
+		return;
+	s_menuRequested = false;
+	if (!s_overlayInitialized || !emu.running())
+		return;
+	// Guarded BEFORE emu.stop(): the overlay is only navigable/closable via
+	// s_joy (poll_overlay_input() returns all-false without one). The
+	// direct-polling path (check_menu_button()) always opens s_joy first,
+	// but the mapped EMU_BTN_MENU path (gamepad_device.cpp) can set
+	// s_menuRequested without ever touching s_joy. Opening the menu with no
+	// joystick available would stop emulation into an overlay nothing can
+	// close - abort instead, before emulation is even stopped.
+	SDL_JoystickUpdate();
+	if (!ensure_joystick())
+		return;
+	try {
+		emu.stop();
+	} catch (...) {
+		return;
+	}
+	emu_ovl_open(&s_overlay); // captures the just-rendered backbuffer
+	reset_input_edges();
+	s_menuActive = true;
+}
