# Copy to .env (untracked) for local builds. `make build` turns these into
# workspace/all/scraper/ss_credentials.h via scripts/gen-ss-credentials.sh.
# Releases read them from GitHub instead (vars.SS_DEV_ID or secrets.SS_DEV_ID,
# secrets.SS_DEV_PASSWORD). Without them the Artwork Manager builds but
# ScreenScraper refuses its requests.

# ScreenScraper developer credentials (request your own at screenscraper.fr)
SS_DEV_ID=
SS_DEV_PASSWORD=
