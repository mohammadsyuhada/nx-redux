{
  "emulator": "mupen64plus-GLideN64",
  "config_file": "mupen64plus.cfg",
  "config_section": "Video-GLideN64",
  "options_hint": "Restart game to apply changes",
  "save_state": true,
  "load_state": true,
  "sections": [
    {
      "name": "Video Plugin",
      "ini_section": "NxRedux",
      "items": [
        {
          "key": "VideoPlugin",
          "label": "Video Plugin",
          "description": "Restart to apply. Rice: fast, best on Brick. GLideN64: accurate, hi-res texture packs. Sections below follow the selected plugin",
          "type": "enum",
          "values": ["gliden64", "rice"],
          "labels": ["GLideN64", "Rice"],
          "default": "gliden64"
        }
      ]
    },
    {
      "name": "Rendering",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "gliden64"},
      "items": [
        {
          "key": "UseNativeResolutionFactor",
          "label": "Resolution Factor",
          "description": "Internal rendering resolution multiplier",
          "type": "cycle",
          "values": [0, 1, 2, 3, 4],
          "labels": ["Auto", "1x", "2x", "3x", "4x"],
          "default": 2
        },
        {
          "key": "AspectRatio",
          "label": "Aspect Ratio",
          "description": "Display aspect ratio mode",
          "type": "cycle",
          "values": [0, 1, 2, 3],
          "labels": ["Auto", "4:3", "16:9", "Stretch"],
          "default": 1
        },
        {
          "key": "FXAA",
          "label": "FXAA",
          "description": "Fast approximate anti-aliasing",
          "type": "bool",
          "default": false
        },
        {
          "key": "MultiSampling",
          "label": "Multi-Sampling",
          "description": "Multi-sample anti-aliasing level",
          "type": "cycle",
          "values": [0, 2, 4, 8],
          "labels": ["Off", "2x", "4x", "8x"],
          "default": 0
        },
        {
          "key": "anisotropy",
          "label": "Anisotropic Filtering",
          "description": "Anisotropic texture filtering",
          "type": "cycle",
          "values": [0, 1, 2, 4, 8, 16],
          "labels": ["Off", "1x", "2x", "4x", "8x", "16x"],
          "default": 2
        },
        {
          "key": "bilinearMode",
          "label": "Bilinear Mode",
          "description": "Texture bilinear filtering mode",
          "type": "cycle",
          "values": [0, 1],
          "labels": ["3-point", "Standard"],
          "default": 1
        },
        {
          "key": "EnableHybridFilter",
          "label": "Hybrid Filter",
          "description": "Hybrid integer scaling filter",
          "type": "bool",
          "default": false
        },
        {
          "key": "EnableHWLighting",
          "label": "HW Lighting",
          "description": "Hardware per-pixel lighting",
          "type": "bool",
          "default": false
        },
        {
          "key": "EnableCoverage",
          "label": "Coverage",
          "description": "Coverage calculation (anti-aliasing)",
          "type": "bool",
          "default": false
        },
        {
          "key": "EnableClipping",
          "label": "Clipping",
          "description": "Vertex clipping",
          "type": "bool",
          "default": true
        },
        {
          "key": "BufferSwapMode",
          "label": "Buffer Swap Mode",
          "description": "Frame buffer swap timing",
          "type": "cycle",
          "values": [0, 1, 2],
          "labels": ["On VI update", "On VI origin change", "On buffer update"],
          "default": 0
        }
      ]
    },
    {
      "name": "Texture Enhancement",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "gliden64"},
      "items": [
        {
          "key": "txFilterMode",
          "label": "Filter Mode",
          "description": "Native texture filter mode",
          "type": "cycle",
          "values": [0, 1, 2, 3, 4, 5, 6],
          "labels": ["None", "Smooth 1", "Smooth 2", "Smooth 3", "Smooth 4", "Sharp 1", "Sharp 2"],
          "default": 0
        },
        {
          "key": "txEnhancementMode",
          "label": "Enhancement Mode",
          "description": "Texture enhancement algorithm",
          "type": "cycle",
          "values": [0, 1, 2, 3, 4, 5, 6, 7],
          "labels": ["None", "2xSaI", "HQ2x", "HQ2xS", "LQ2x", "LQ2xS", "HQ4x", "2xBRZ"],
          "default": 0
        },
        {
          "key": "txDeposterize",
          "label": "Deposterize",
          "description": "Reduce posterization in enhanced textures",
          "type": "bool",
          "default": false
        },
        {
          "key": "txFilterIgnoreBG",
          "label": "Ignore BG Textures",
          "description": "Skip enhancement for background textures",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "name": "Hi-Res Textures",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "gliden64"},
      "items": [
        {
          "key": "txHiresEnable",
          "label": "Enable Hi-Res",
          "description": "Load high-resolution texture packs",
          "type": "bool",
          "default": true
        },
        {
          "key": "txHiresTextureFileStorage",
          "label": "File Storage",
          "description": "Lazy load textures from files",
          "type": "bool",
          "default": true
        },
        {
          "key": "txHiresFullAlphaChannel",
          "label": "Full Alpha Channel",
          "description": "Use full alpha channel for hi-res",
          "type": "bool",
          "default": true
        },
        {
          "key": "txHresAltCRC",
          "label": "Alt CRC",
          "description": "Use alternative CRC for texture matching",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "name": "Dithering",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "gliden64"},
      "items": [
        {
          "key": "EnableDitheringPattern",
          "label": "Dithering Pattern",
          "description": "N64 dithering pattern emulation",
          "type": "bool",
          "default": false
        },
        {
          "key": "DitheringQuantization",
          "label": "Quantization",
          "description": "Dithering quantization",
          "type": "bool",
          "default": true
        },
        {
          "key": "RDRAMImageDitheringMode",
          "label": "RDRAM Dithering",
          "description": "RDRAM image dithering algorithm",
          "type": "cycle",
          "values": [0, 1, 2, 3],
          "labels": ["Off", "Bayer", "Magic Square", "Blue Noise"],
          "default": 3
        },
        {
          "key": "EnableHiresNoiseDithering",
          "label": "Hi-Res Noise Dithering",
          "description": "Noise dithering for hi-res output",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "name": "Frame Buffer",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "gliden64"},
      "items": [
        {
          "key": "EnableFBEmulation",
          "label": "FB Emulation",
          "description": "Frame buffer emulation (required for many effects)",
          "type": "bool",
          "default": true
        },
        {
          "key": "EnableCopyColorToRDRAM",
          "label": "Color to RDRAM",
          "description": "Copy color buffer to N64 memory",
          "type": "cycle",
          "values": [0, 1, 2],
          "labels": ["Off", "Sync", "Async"],
          "default": 2
        },
        {
          "key": "EnableCopyDepthToRDRAM",
          "label": "Depth to RDRAM",
          "description": "Copy depth buffer to N64 memory",
          "type": "cycle",
          "values": [0, 1, 2],
          "labels": ["Off", "From VRAM", "Software"],
          "default": 2
        },
        {
          "key": "EnableCopyColorFromRDRAM",
          "label": "Color from RDRAM",
          "description": "Copy color buffer from N64 memory",
          "type": "bool",
          "default": false
        },
        {
          "key": "EnableN64DepthCompare",
          "label": "N64 Depth Compare",
          "description": "N64 depth compare (CPU intensive)",
          "type": "cycle",
          "values": [0, 1, 2],
          "labels": ["Off", "Fast", "Compatible"],
          "default": 0
        },
        {
          "key": "DisableFBInfo",
          "label": "Disable FB Info",
          "description": "Disable frame buffer info (performance)",
          "type": "bool",
          "default": true
        }
      ]
    },
    {
      "name": "Performance",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "gliden64"},
      "items": [
        {
          "key": "EnableInaccurateTextureCoordinates",
          "label": "Inaccurate Tex Coords",
          "description": "Faster but less accurate texture coords",
          "type": "bool",
          "default": false
        },
        {
          "key": "EnableLegacyBlending",
          "label": "Legacy Blending",
          "description": "Use legacy blending mode",
          "type": "bool",
          "default": false
        },
        {
          "key": "EnableShadersStorage",
          "label": "Shader Cache",
          "description": "Cache compiled shaders to disk",
          "type": "bool",
          "default": true
        },
        {
          "key": "EnableFragmentDepthWrite",
          "label": "Fragment Depth Write",
          "description": "Write fragment depth in shader",
          "type": "bool",
          "default": true
        },
        {
          "key": "BackgroundsMode",
          "label": "Backgrounds Mode",
          "description": "Background rendering mode",
          "type": "cycle",
          "values": [0, 1, 2],
          "labels": ["One piece", "Stripped", "Best performance"],
          "default": 0
        }
      ]
    },
    {
      "name": "Gamma",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "gliden64"},
      "items": [
        {
          "key": "ForceGammaCorrection",
          "label": "Force Gamma",
          "description": "Force gamma correction",
          "type": "bool",
          "default": false
        },
        {
          "key": "GammaCorrectionLevel",
          "label": "Gamma Level",
          "description": "Gamma correction level",
          "type": "cycle",
          "values": [10, 15, 20, 25, 30, 35, 40, 45, 50],
          "labels": ["1.0", "1.5", "2.0", "2.5", "3.0", "3.5", "4.0", "4.5", "5.0"],
          "float_scale": 10,
          "default": 20
        }
      ]
    },
    {
      "name": "Rendering",
      "ini_section": "Video-Rice",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "rice"},
      "items": [
        {
          "key": "AspectRatio",
          "label": "Aspect Ratio",
          "description": "Keep on 4:3 for correct geometry. 16:9 and Stretch distort the picture -- Rice has no true widescreen; use GLideN64 for that",
          "type": "cycle",
          "values": [1, 2, 0],
          "labels": ["4:3", "16:9", "Stretch"],
          "default": 1
        },
        {
          "key": "MultiSampling",
          "label": "Multi-Sampling",
          "description": "Multi-sample anti-aliasing level (costs GPU time)",
          "type": "cycle",
          "values": [0, 2, 4, 8],
          "labels": ["Off", "2x", "4x", "8x"],
          "default": 0
        },
        {
          "key": "Mipmapping",
          "label": "Mipmapping",
          "description": "Texture mipmapping quality",
          "type": "cycle",
          "values": [0, 1, 2, 3],
          "labels": ["Off", "Nearest", "Bilinear", "Trilinear"],
          "default": 2
        },
        {
          "key": "AnisotropicFiltering",
          "label": "Anisotropic Filtering",
          "description": "Anisotropic filtering for mipmapped textures (no effect when Mipmapping is Off)",
          "type": "cycle",
          "values": [0, 2, 4, 8, 16],
          "labels": ["Off", "2x", "4x", "8x", "16x"],
          "default": 0
        },
        {
          "key": "ForceTextureFilter",
          "label": "Texture Filter",
          "description": "Auto lets the game choose; or force texture filtering off or on",
          "type": "cycle",
          "values": [0, 1, 2],
          "labels": ["Auto", "Force Off", "Force On"],
          "default": 0
        },
        {
          "key": "FogMethod",
          "label": "Fog",
          "description": "Fog generation",
          "type": "cycle",
          "values": [0, 1],
          "labels": ["Off", "On"],
          "default": 1
        },
        {
          "key": "AccurateTextureMapping",
          "label": "Accurate Texture Mapping",
          "description": "Alternative texture coordinate clamping (more accurate)",
          "type": "bool",
          "default": true
        }
      ]
    },
    {
      "name": "Texture Enhancement",
      "ini_section": "Video-Rice",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "rice"},
      "items": [
        {
          "key": "TextureEnhancement",
          "label": "Enhancement",
          "description": "Texture upscaling filter (CPU intensive)",
          "type": "cycle",
          "values": [0, 1, 2, 3, 4, 5, 6, 7],
          "labels": ["None", "2X", "2xSaI", "HQ2X", "LQ2X", "HQ4X", "Sharpen", "Sharpen More"],
          "default": 0
        },
        {
          "key": "TextureEnhancementControl",
          "label": "Enhancement Control",
          "description": "Secondary smoothing pass for the enhancement filter",
          "type": "cycle",
          "values": [0, 1, 2, 3, 4],
          "labels": ["None", "1", "2", "3", "4"],
          "default": 0
        },
        {
          "key": "TextureQuality",
          "label": "Texture Quality",
          "description": "Color depth used for textures",
          "type": "cycle",
          "values": [0, 1, 2],
          "labels": ["Default", "32-bit", "16-bit"],
          "default": 0
        }
      ]
    },
    {
      "name": "Frame Buffer",
      "ini_section": "Video-Rice",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "rice"},
      "items": [
        {
          "key": "FrameBufferSetting",
          "label": "FB Emulation",
          "description": "Frame buffer emulation; ROM default uses the per-game setting",
          "type": "cycle",
          "values": [0, 1],
          "labels": ["ROM default", "Disabled"],
          "default": 0
        },
        {
          "key": "RenderToTexture",
          "label": "Render to Texture",
          "description": "Render-to-texture emulation",
          "type": "cycle",
          "values": [0, 1, 2, 3, 4],
          "labels": ["None", "Ignore", "Normal", "Write Back", "Write Back + Reload"],
          "default": 0
        },
        {
          "key": "ScreenUpdateSetting",
          "label": "Screen Update",
          "description": "When the screen is updated; try other values if a game flickers",
          "type": "cycle",
          "values": [0, 1, 2, 3, 4, 5, 6, 7],
          "labels": ["ROM default", "VI origin update", "VI origin change", "CI change", "First CI change", "First primitive", "Before screen clear", "After screen drawn"],
          "default": 4
        },
        {
          "key": "InN64Resolution",
          "label": "N64-Res Frame Buffers",
          "description": "Emulated frame buffers at native N64 resolution",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "name": "Performance",
      "ini_section": "Video-Rice",
      "visible_when": {"ini_section": "NxRedux", "key": "VideoPlugin", "value": "rice"},
      "items": [
        {
          "key": "FastTextureLoading",
          "label": "Fast Texture Loading",
          "description": "Faster texture loading and CRC (may glitch some games)",
          "type": "bool",
          "default": false
        },
        {
          "key": "SkipFrame",
          "label": "Skip Frame",
          "description": "Render every other frame",
          "type": "bool",
          "default": false
        },
        {
          "key": "FullTMEMEmulation",
          "label": "Full TMEM Emulation",
          "description": "Full texture memory emulation (fixes some games, breaks others, slower)",
          "type": "bool",
          "default": false
        }
      ]
    }
  ]
}
