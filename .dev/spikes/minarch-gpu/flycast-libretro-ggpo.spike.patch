+#ifdef NX_LIBRETRO_GGPO
+// SPIKE (minarch-gpu-spike): GGPO netplay in the libretro core. The frontend
+// (for the spike: environment variables set by the launcher) configures the
+// session before the game loads; the handshake standalone runs from its UI
+// (core/ui/gui.cpp) is started and awaited here, after the game has loaded.
+#include "network/net_handshake.h"
+#include <chrono>
+static bool nx_ggpo_configure()
+{
+	const char *on = getenv("NX_GGPO");
+	if (on == nullptr || strcmp(on, "1") != 0)
+		return false;
+	const char *host = getenv("NX_GGPO_HOST");
+	const char *server = getenv("NX_GGPO_SERVER");
+	const char *delay = getenv("NX_GGPO_DELAY");
+	config::GGPOEnable.override(true);
+	config::NetworkEnable.override(false);
+	config::EnableUPnP.override(false);
+	config::ActAsServer.override(host != nullptr && strcmp(host, "1") == 0);
+	config::NetworkServer.override(std::string(server != nullptr ? server : ""));
+	config::GGPODelay.override(delay != nullptr ? atoi(delay) : 1);
+	// GGPO always drives port B as player 2: both machines need a controller
+	// there (the frontend only plugs port A)
+	retro_set_controller_port_device(1, RETRO_DEVICE_JOYPAD);
+	NOTICE_LOG(NETWORK, "NX GGPO: %s, server '%s', delay %d", config::ActAsServer ? "host" : "client",
+			config::NetworkServer.get().c_str(), config::GGPODelay.get());
+	return true;
+}
+static bool nx_ggpo_start()
+{
+	if (NetworkHandshake::instance == nullptr)
+	{
+		ERROR_LOG(NETWORK, "NX GGPO: no network handshake after load");
+		return false;
+	}
+	const char *t = getenv("NX_GGPO_TIMEOUT");
+	int timeout = t != nullptr ? atoi(t) : 60;
+	std::future<bool> status = NetworkHandshake::instance->start();
+	if (status.wait_for(std::chrono::seconds(timeout)) != std::future_status::ready)
+	{
+		ERROR_LOG(NETWORK, "NX GGPO: peer not synchronized after %d s", timeout);
+		NetworkHandshake::instance->stop();
+		return false;
+	}
+	try {
+		if (!status.get())
+		{
+			ERROR_LOG(NETWORK, "NX GGPO: handshake failed");
+			return false;
+		}
+	} catch (const FlycastException& e) {
+		ERROR_LOG(NETWORK, "NX GGPO: %s", e.what());
+		return false;
+	}
+	NOTICE_LOG(NETWORK, "NX GGPO: synchronized with peer");
+	return true;
+}
+#endif
